{
  "run_name": "r50_416",
  "arch": "resnet50",
  "pretrained": true,
  "image_size": 416,
  "train_transform": "strong_train",
  "aug": {
    "crop_scale": [
      0.5,
      1.0
    ],
    "hflip": 0.5,
    "color_jitter": true,
    "jitter_brightness": 0.35,
    "jitter_contrast": 0.35,
    "jitter_saturation": 0.35,
    "jitter_hue": 0.08,
    "randaugment": true,
    "ra_num_ops": 2,
    "ra_magnitude": 7,
    "random_erasing": 0.25,
    "eval_resize_ratio": 1.142857
  },
  "epochs": 18,
  "batch_size": 10,
  "optimizer": "sgd",
  "lr": 0.01,
  "momentum": 0.9,
  "weight_decay": 0.0001,
  "head_lr_mult": 1.0,
  "scheduler": "cosine",
  "warmup_epochs": 2,
  "label_smoothing": 0.1,
  "class_weight": "none",
  "unknown_weight_mult": 1.0,
  "ema_decay": 0.999,
  "mixup_alpha": 0.2,
  "cutmix_alpha": 0.5,
  "mix_prob": 0.35,
  "tta_hflip": true,
  "grad_clip": 5.0,
  "seed": 42,
  "threads": 12,
  "amp": true,
  "num_workers": 6,
  "checkpoint_interval": 3,
  "log_interval": 60,
  "note": "E2：ResNet50 @416。分辨率是本项目已验证的最大杠杆（224→288→352 每一步都有收益），继续往上推，看细粒度识别的收益是否还在。",
  "device": "auto",
  "pin_memory": true
}