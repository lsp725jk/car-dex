{
  "run_name": "baseline_resnet18_160",
  "arch": "resnet18",
  "pretrained": true,
  "image_size": 160,
  "train_transform": "baseline_train",
  "aug": {
    "crop_scale": [0.70, 1.0],
    "hflip": 0.5,
    "eval_resize_ratio": 1.142857
  },
  "epochs": 12,
  "batch_size": 32,
  "optimizer": "sgd",
  "lr": 0.01,
  "momentum": 0.9,
  "weight_decay": 0.0001,
  "head_lr_mult": 1.0,
  "scheduler": "cosine",
  "warmup_epochs": 1,
  "label_smoothing": 0.0,
  "class_weight": "none",
  "ema_decay": 0.0,
  "mixup_alpha": 0.0,
  "cutmix_alpha": 0.0,
  "mix_prob": 0.0,
  "tta_hflip": false,
  "grad_clip": 5.0,
  "seed": 42,
  "threads": 12,
  "amp": true,
  "num_workers": 0,
  "checkpoint_interval": 4,
  "log_interval": 60,
  "note": "基线：ResNet18 + ImageNet 预训练 + 轻量增强（随机裁剪/水平翻转）+ 交叉熵 + SGD 余弦退火，unknown 作为第 51 类直接参与训练。"
}
