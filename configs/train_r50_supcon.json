{
  "run_name": "r50_288_supcon",
  "arch": "resnet50",
  "pretrained": true,
  "image_size": 288,
  "train_transform": "strong_train",
  "aug": {
    "crop_scale": [
      0.5,
      1.0
    ],
    "hflip": 0.5,
    "color_jitter": true,
    "jitter_brightness": 0.35,
    "jitter_contrast": 0.35,
    "jitter_saturation": 0.35,
    "jitter_hue": 0.08,
    "randaugment": true,
    "ra_num_ops": 2,
    "ra_magnitude": 7,
    "random_erasing": 0.25,
    "eval_resize_ratio": 1.142857
  },
  "epochs": 16,
  "batch_size": 24,
  "optimizer": "sgd",
  "lr": 0.01,
  "momentum": 0.9,
  "weight_decay": 0.0001,
  "head_lr_mult": 1.0,
  "scheduler": "cosine",
  "warmup_epochs": 2,
  "label_smoothing": 0.1,
  "class_weight": "none",
  "unknown_weight_mult": 1.0,
  "ema_decay": 0.999,
  "mixup_alpha": 0.0,
  "cutmix_alpha": 0.0,
  "mix_prob": 0.0,
  "tta_hflip": true,
  "grad_clip": 5.0,
  "seed": 42,
  "threads": 12,
  "amp": true,
  "num_workers": 6,
  "checkpoint_interval": 3,
  "log_interval": 60,
  "note": "E1：ResNet50 @288 + Supervised Contrastive Learning。关键设计——对比损失用 **fine 标签**（50 个已知类 + 98 个 unknown 来源类 = 149 类），而不是 51 类标签。因为对 51 类做对比会把所有 unknown 拉成一团（让 MINI CLUBMAN 和卡车变相似），是有害的。用 fine 标签才能真正让近似款在特征空间拉开距离。",
  "device": "auto",
  "pin_memory": true,
  "supcon": true,
  "supcon_weight": 0.5,
  "supcon_temperature": 0.1,
  "supcon_views": 2,
  "supcon_dim": 128,
  "supcon_head_lr_mult": 5.0
}