{
  "run_name": "wide_r50_2_288",
  "arch": "wide_resnet50_2",
  "pretrained": true,
  "image_size": 288,
  "train_transform": "strong_train",
  "aug": {
    "crop_scale": [
      0.5,
      1.0
    ],
    "hflip": 0.5,
    "color_jitter": true,
    "jitter_brightness": 0.35,
    "jitter_contrast": 0.35,
    "jitter_saturation": 0.35,
    "jitter_hue": 0.08,
    "randaugment": true,
    "ra_num_ops": 2,
    "ra_magnitude": 7,
    "random_erasing": 0.25,
    "eval_resize_ratio": 1.142857
  },
  "epochs": 16,
  "batch_size": 12,
  "optimizer": "sgd",
  "lr": 0.01,
  "momentum": 0.9,
  "weight_decay": 0.0001,
  "head_lr_mult": 1.0,
  "scheduler": "cosine",
  "warmup_epochs": 2,
  "label_smoothing": 0.1,
  "class_weight": "none",
  "unknown_weight_mult": 1.0,
  "ema_decay": 0.999,
  "mixup_alpha": 0.2,
  "cutmix_alpha": 0.5,
  "mix_prob": 0.35,
  "tta_hflip": true,
  "grad_clip": 5.0,
  "seed": 42,
  "threads": 12,
  "amp": true,
  "num_workers": 6,
  "checkpoint_interval": 3,
  "log_interval": 60,
  "note": "E3：Wide ResNet50_2 @288（68.9M 参数，ResNet50 的 2.7 倍）。用于隔离骨干容量这一变量的收益 —— 注意 intermediate 通道翻倍，所以 fc.in_features 仍是 2048，分类头不用改。",
  "device": "auto",
  "pin_memory": true
}