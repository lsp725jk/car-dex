{
  "run_name": "weighted_resnet18_160",
  "arch": "resnet18",
  "pretrained": true,
  "image_size": 160,
  "train_transform": "baseline_train",
  "aug": {
    "crop_scale": [0.70, 1.0],
    "hflip": 0.5,
    "eval_resize_ratio": 1.142857
  },
  "epochs": 12,
  "batch_size": 32,
  "optimizer": "sgd",
  "lr": 0.01,
  "momentum": 0.9,
  "weight_decay": 0.0001,
  "head_lr_mult": 1.0,
  "scheduler": "cosine",
  "warmup_epochs": 1,
  "label_smoothing": 0.0,
  "class_weight": "inverse",
  "unknown_weight_mult": 1.0,
  "ema_decay": 0.0,
  "mixup_alpha": 0.0,
  "cutmix_alpha": 0.0,
  "mix_prob": 0.0,
  "tta_hflip": false,
  "grad_clip": 5.0,
  "seed": 42,
  "threads": 12,
  "amp": true,
  "num_workers": 0,
  "checkpoint_interval": 4,
  "log_interval": 60,
  "note": "对比实验 B：在基线之上仅增加类别平衡损失（逆频率加权 w_c ∝ 1/n_c，使每个类别对损失的贡献相等，并用 N/(C·n_c) 归一化），其余完全相同，用于隔离“类别不平衡处理”的贡献。"
}
