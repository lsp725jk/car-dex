{
  "run_name": "improved_resnet50_224",
  "arch": "resnet50",
  "pretrained": true,
  "image_size": 224,
  "train_transform": "strong_train",
  "aug": {
    "crop_scale": [
      0.5,
      1.0
    ],
    "hflip": 0.5,
    "color_jitter": true,
    "jitter_brightness": 0.35,
    "jitter_contrast": 0.35,
    "jitter_saturation": 0.35,
    "jitter_hue": 0.08,
    "randaugment": true,
    "ra_num_ops": 2,
    "ra_magnitude": 7,
    "random_erasing": 0.25,
    "eval_resize_ratio": 1.142857
  },
  "epochs": 14,
  "batch_size": 32,
  "optimizer": "sgd",
  "lr": 0.01,
  "momentum": 0.9,
  "weight_decay": 0.0001,
  "head_lr_mult": 1.0,
  "scheduler": "cosine",
  "warmup_epochs": 2,
  "label_smoothing": 0.1,
  "class_weight": "none",
  "unknown_weight_mult": 1.0,
  "ema_decay": 0.999,
  "mixup_alpha": 0.2,
  "cutmix_alpha": 0.5,
  "mix_prob": 0.35,
  "tta_hflip": true,
  "grad_clip": 5.0,
  "seed": 42,
  "threads": 12,
  "amp": true,
  "num_workers": 6,
  "checkpoint_interval": 3,
  "log_interval": 60,
  "note": "改进模型 C2：ResNet50 @224（ImageNet V1 预训练）+ 与 C1 相同的强增强 / EMA / MixUp+CutMix / TTA 配方，类别权重 none，用于隔离“骨干网络容量”这一变量的收益。",
  "device": "auto",
  "pin_memory": true
}