{
  "run_name": "improved_resnet18_224_moderate",
  "arch": "resnet18",
  "pretrained": true,
  "image_size": 224,
  "train_transform": "moderate_train",
  "aug": {
    "crop_scale": [0.65, 1.0],
    "hflip": 0.5,
    "color_jitter": true,
    "jitter_brightness": 0.25,
    "jitter_contrast": 0.25,
    "jitter_saturation": 0.25,
    "jitter_hue": 0.05,
    "random_erasing": 0.15,
    "eval_resize_ratio": 1.142857
  },
  "epochs": 14,
  "batch_size": 32,
  "optimizer": "sgd",
  "lr": 0.01,
  "momentum": 0.9,
  "weight_decay": 0.0001,
  "head_lr_mult": 1.0,
  "scheduler": "cosine",
  "warmup_epochs": 1,
  "label_smoothing": 0.05,
  "class_weight": "none",
  "unknown_weight_mult": 1.0,
  "ema_decay": 0.999,
  "mixup_alpha": 0.0,
  "cutmix_alpha": 0.0,
  "mix_prob": 0.0,
  "tta_hflip": true,
  "grad_clip": 5.0,
  "seed": 42,
  "threads": 12,
  "amp": true,
  "num_workers": 0,
  "checkpoint_interval": 4,
  "log_interval": 60,
  "note": "备选配方：ResNet18 @224 + 中等强度增强（缩放裁剪 + 颜色抖动 + 随机擦除，不用 RandAugment/MixUp）+ 标签平滑 0.05 + EMA + TTA。用于判断强增强是否对 7.5k 规模的数据集过度正则化。"
}
